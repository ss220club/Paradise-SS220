{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dreammaker",
			"dme": "paradise.dme",
			"dependsOn": "tgui: ensure",
			"dependsOrder": "sequence",
			"problemMatcher": [
				"$dreammaker"
			],
			"group": "build",
			"label": "dm: build - paradise.dme"
		},
		{
			"type": "shell",
			"command": ".\\tgui\\bin\\tgui.bat",
			"linux":{
				"command": "tgui/bin/tgui",
			},
			"problemMatcher": [
				"$tsc",
				"$eslint-stylish"
			],
			"group": "build",
			"label": "tgui: build"
		},
		{
			"type": "shell",
			"command": ".\\tgui\\bin\\tgui.bat",
			"args": ["--ensure"],
			"linux": {
				"command": "tgui/bin/tgui",
				"args": ["--ensure"]
			},
			"problemMatcher": [],
			"label": "tgui: ensure"
		},
		{
			"type": "shell",
			"command": ".\\tgui\\bin\\tgui-dev-server.bat",
			"linux":{
				"command": "tgui/bin/tgui",
				"args": ["--dev"]
			},
			"problemMatcher": [
				"$tsc",
				"$eslint-stylish"
			],
			"group": "build",
			"label": "tgui: run dev server"
		},
		{
			"type": "shell",
			"command": ".\\tgui\\bin\\tgui.bat",
			"args": ["--prettier", "--check", "${file}"],
			"linux": {
				"command": "tgui/bin/tgui",
				"args": ["--prettier", "--check", "${file}"]
			},
			"problemMatcher": [],
			"label": "tgui: Prettier check current file"
		},
		{
			"type": "shell",
			"command": ".\\tgui\\bin\\tgui.bat",
			"args": ["--prettier", "--write", "${file}"],
			"linux": {
				"command": "tgui/bin/tgui",
				"args": ["--prettier", "--write", "${file}"]
			},
			"problemMatcher": [],
			"label": "tgui: Prettier write current file"
		},
		{
			"type": "shell",
			"command": ".\\tools\\translations\\new_ru_name_fragment.cmd",
			"args": ["${selectedText}"],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false,
				"showReuseMessage": false,
				"clear": false,
				"close": false
			},
			"problemMatcher": [],
			"label": "ru_names: new fragment from selection",
		}
	]
}
