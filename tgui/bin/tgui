#!/bin/bash
## Copyright (c) 2020 Aleksej Komarov
## SPDX-License-Identifier: MIT

set -e
shopt -s globstar
shopt -s expand_aliases

## Initial set-up
## --------------------------------------------------------

## Returns an absolute path to file
alias tgui-realpath="readlink -f"

## Fallbacks for GNU readlink
## Detecting GNU coreutils http://stackoverflow.com/a/8748344/319952
if ! readlink --version >/dev/null 2>&1; then
  if hash greadlink 2>/dev/null; then
    alias tgui-realpath="greadlink -f"
  else
    alias tgui-realpath="perl -MCwd -le 'print Cwd::abs_path(shift)'"
  fi
fi

## Find a canonical path to project root
base_dir="$(dirname "$(tgui-realpath "${0}")")/.."
base_dir="$(tgui-realpath "${base_dir}")"

## Fall back to running Yarn from the repo
if ! hash yarn 2>/dev/null; then
  yarn_releases=("${base_dir}"/.yarn/releases/yarn-*.cjs)
  yarn_release="${yarn_releases[0]}"
  yarn() {
    node "${yarn_release}" "${@}"
  }
fi


## Functions
## --------------------------------------------------------

## Installs node modules
task-install() {
  cd "${base_dir}"
  yarn install
}

## Runs rspack
task-rspack() {
  cd "${base_dir}"
  yarn run rspack "${@}"
}

## Runs a development server
task-dev-server() {
  cd "${base_dir}"
  yarn node --experimental-modules packages/tgui-dev-server/index.js "${@}"
}

## Run a linter through all packages
task-lint() {
  cd "${base_dir}"
  yarn run tsc
  echo "tgui: type check passed"
  yarn run eslint packages "${@}"
  echo "tgui: eslint check passed"
}

task-test() {
  cd "${base_dir}"
  yarn run vitest
}

task-prettier() {
  cd "${base_dir}"
  npx prettier --check packages "${@}"
}

## Mr. Proper
task-clean() {
  cd "${base_dir}"
  echo "tgui: cleaning build artifacts"
  ## Build artifacts
  rm -rf public/.tmp
  rm -f public/*.map
  rm -f public/*.hot-update.*
  echo "tgui: cleaning Yarn artifacts"
  ## Yarn artifacts
  rm -rf .yarn/cache
  rm -rf .yarn/unplugged
  rm -rf .yarn/rspack
  rm -rf .yarn/build-state.yml
  rm -rf .yarn/install-state.gz
  rm -f .pnp.*
  echo "tgui: cleaning NPM artifacts"
  ## NPM artifacts
  rm -rf **/node_modules
  rm -f **/package-lock.json
  echo "tgui: All artifacts cleaned"
}

## Returns success when TGUI sources differ from HEAD or include new files.
task-tgui-is-dirty() {
  local git_root
  git_root="$(git -C "${base_dir}/.." rev-parse --show-toplevel)"
  ! git -C "${git_root}" diff --quiet -- tgui ||
    ! git -C "${git_root}" diff --cached --quiet -- tgui ||
    [[ -n $(git -C "${git_root}" ls-files --others --exclude-standard -- tgui) ]]
}

task-tgui-tree-hash() {
  git -C "${base_dir}/.." rev-parse HEAD:tgui
}

task-write-bundle-marker() {
  local tgui_tree_hash
  if task-tgui-is-dirty; then
    rm -f "${base_dir}/public/.tgui-bundle.json"
    return
  fi
  tgui_tree_hash="$(task-tgui-tree-hash)"
  printf '{\n  "tguiTreeHash": "%s"\n}\n' "${tgui_tree_hash}" > "${base_dir}/public/.tgui-bundle.json"
}

task-build-production() {
  task-install
  task-lint --fix
  # These files are not included in the Rspack configuration, but are required
  # by tgui.html at runtime.
  yarn run build:helpers
  # The stylesheet has a CSS entrypoint, which Rspack does not build directly.
  yarn run build:style
  task-rspack --mode=production
  task-write-bundle-marker
}

task-json-value() {
  local key="${1}"
  local file="${2}"
  sed -nE "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"([^\"]+)\".*/\1/p" "${file}" | head -n 1
}

task-archive-sha256() {
  if hash sha256sum 2>/dev/null; then
    sha256sum "${1}" | awk '{print $1}'
  elif hash shasum 2>/dev/null; then
    shasum -a 256 "${1}" | awk '{print $1}'
  else
    return 1
  fi
}

task-ensure-bundle() {
  local release_url="https://github.com/ss220club/Paradise-SS220/releases/download/tgui-bundles"
  local tgui_tree_hash
  local marker
  local manifest
  local archive
  local manifest_tgui_tree_hash
  local archive_name
  local archive_sha256

  if task-tgui-is-dirty; then
    echo "tgui: source changes detected; building TGUI locally"
    task-build-production
    return
  fi

  tgui_tree_hash="$(task-tgui-tree-hash)"
  marker="${base_dir}/public/.tgui-bundle.json"
  if [[ -f "${marker}" ]] && [[ "$(task-json-value tguiTreeHash "${marker}")" == "${tgui_tree_hash}" ]] && [[ -f "${base_dir}/public/tgui.bundle.js" ]]; then
    echo "tgui: using local bundle"
    return
  fi

  manifest="${base_dir}/public/.tmp/tgui-manifest.json"
  archive="${base_dir}/public/.tmp/tgui-public.zip"
  mkdir -p "${base_dir}/public/.tmp"
  if hash curl 2>/dev/null && curl -fsSL "${release_url}/tgui-manifest.json" -o "${manifest}"; then
    manifest_tgui_tree_hash="$(task-json-value tguiTreeHash "${manifest}")"
    archive_name="$(task-json-value archiveName "${manifest}")"
    archive_sha256="$(task-json-value archiveSha256 "${manifest}")"
    if [[ "${manifest_tgui_tree_hash}" == "${tgui_tree_hash}" ]] && [[ "${archive_name}" == "tgui-public.zip" ]] && \
      curl -fsSL "${release_url}/${archive_name}" -o "${archive}" && \
      [[ "$(task-archive-sha256 "${archive}")" == "${archive_sha256}" ]] && hash unzip 2>/dev/null; then
      unzip -oq "${archive}" -d "${base_dir}"
      if [[ -f "${marker}" ]] && [[ "$(task-json-value tguiTreeHash "${marker}")" == "${tgui_tree_hash}" ]]; then
        echo "tgui: downloaded bundle"
        return
      fi
    fi
  fi

  echo "tgui: no compatible published bundle; building TGUI locally"
  task-build-production
}

## Main
## --------------------------------------------------------

if [[ ${1} == "--ensure" ]]; then
  task-ensure-bundle
  exit 0
fi

if [[ ${1} == "--clean" ]]; then
  task-clean
  exit 0
fi

if [[ ${1} == "--dev" ]]; then
  shift
  task-install
  task-dev-server "${@}"
  exit 0
fi

if [[ ${1} == '--lint' ]]; then
  shift 1
  task-install
  task-lint "${@}"
  exit 0
fi

if [[ ${1} == '--fix' ]]; then
  shift 1
  task-install
  task-lint --fix "${@}"
  exit 0
fi

## Analyze the bundle
if [[ ${1} == '--analyze' ]]; then
  task-install
  task-rspack --mode=production --analyze
  exit 0
fi

## Jest test
if [[ ${1} == '--test' ]]; then
  shift 1
  task-install
  task-test "${@}"
  exit 0
fi

## Continuous integration scenario
if [[ ${1} == "--ci" ]]; then
  task-clean
  task-install
  task-prettier
  task-test "${@}"
  task-lint
  task-rspack --mode=production
  # The following two scripts aren't included in the rspack configuration,
  # because they do not import other files, and consequently, they do not need a bundler.
  # Furthermore, they are only included in CI builds because these files change so rarely.
  # However, when they do change, the CI must fail if the build outputs weren't updated.
  yarn run build:helpers
  # The following script can't be trivially included into the rspack configuration,
  # because its entrypoint is a CSS file, which is not supported by webpack and subsequently rspack.
  yarn run build:style
  task-write-bundle-marker
  exit 0
fi

## Run prettier
if [[ ${1} == '--prettier' ]]; then
  shift 1
  npx prettier "${@}"
  exit 0
fi

## Make a production rspack build
if [[ -z ${1} ]]; then
  task-build-production
  exit 0
fi

## Run rspack with custom flags
task-install
task-rspack "${@}"
